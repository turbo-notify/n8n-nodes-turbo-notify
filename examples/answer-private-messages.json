{
	"name": "Answer private WhatsApp messages",
	"nodes": [
		{
			"parameters": {
				"events": [
					"message.received"
				],
				"pollTimes": {
					"item": [
						{
							"mode": "everyMinute"
						}
					]
				}
			},
			"id": "7a1c0e2f-3b4d-4c5e-8f60-a1b2c3d4e500",
			"name": "Turbo Notify Polling Trigger",
			"type": "@turbo-notify/n8n-nodes-turbo-notify.turboNotifyPollingTrigger",
			"typeVersion": 1,
			"position": [
				0,
				0
			],
			"credentials": {
				"turboNotifyApi": {
					"id": "REPLACE_WITH_YOUR_CREDENTIAL",
					"name": "Turbo Notify API"
				}
			}
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "loose",
						"version": 2
					},
					"conditions": [
						{
							"id": "cond-1",
							"leftValue": "={{ $json.data.to.group_id }}",
							"rightValue": "",
							"operator": {
								"type": "string",
								"operation": "empty",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "7a1c0e2f-3b4d-4c5e-8f60-a1b2c3d4e601",
			"name": "Private chat only",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [
				260,
				0
			]
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "sendTypingIndicator",
				"number": {
					"__rl": true,
					"mode": "id",
					"value": "={{ $('Turbo Notify Polling Trigger').item.json.number_id }}"
				},
				"recipientType": "auto",
				"recipient": "={{ '+' + $('Turbo Notify Polling Trigger').item.json.data.from.number }}",
				"isTyping": true
			},
			"id": "7a1c0e2f-3b4d-4c5e-8f60-a1b2c3d4e502",
			"name": "Show typing",
			"type": "@turbo-notify/n8n-nodes-turbo-notify.turboNotify",
			"typeVersion": 1,
			"position": [
				520,
				0
			],
			"credentials": {
				"turboNotifyApi": {
					"id": "REPLACE_WITH_YOUR_CREDENTIAL",
					"name": "Turbo Notify API"
				}
			},
			"onError": "continueRegularOutput"
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "reply",
				"number": {
					"__rl": true,
					"mode": "id",
					"value": "={{ $('Turbo Notify Polling Trigger').item.json.number_id }}"
				},
				"messageId": "={{ $('Turbo Notify Polling Trigger').item.json.data.id }}",
				"text": "Thanks for your message. We will answer during business hours."
			},
			"id": "7a1c0e2f-3b4d-4c5e-8f60-a1b2c3d4e503",
			"name": "Reply to the message",
			"type": "@turbo-notify/n8n-nodes-turbo-notify.turboNotify",
			"typeVersion": 1,
			"position": [
				780,
				0
			],
			"credentials": {
				"turboNotifyApi": {
					"id": "REPLACE_WITH_YOUR_CREDENTIAL",
					"name": "Turbo Notify API"
				}
			}
		},
		{
			"parameters": {
				"content": "**On the Free plan**\nThe typing step needs the Lone Wolf plan: on the Free plan it fails and the workflow goes on. The trigger checks once a minute, so the answer comes within a minute.",
				"height": 200,
				"width": 360
			},
			"id": "7a1c0e2f-3b4d-4c5e-8f60-a1b2c3d4e9b1",
			"name": "Note b1",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				0,
				-280
			]
		}
	],
	"connections": {
		"Turbo Notify Polling Trigger": {
			"main": [
				[
					{
						"node": "Private chat only",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Private chat only": {
			"main": [
				[
					{
						"node": "Show typing",
						"type": "main",
						"index": 0
					}
				],
				[]
			]
		},
		"Show typing": {
			"main": [
				[
					{
						"node": "Reply to the message",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"pinData": {},
	"settings": {
		"executionOrder": "v1"
	}
}
