{
	"name": "@turbo-notify/n8n-nodes-turbo-notify",
	"version": "0.3.3",
	"description": "Send and receive WhatsApp messages, read contacts and groups, and react to events with Turbo Notify.",
	"license": "MIT",
	"homepage": "https://docs.turbonotify.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"whatsapp",
		"whatsapp-api",
		"whatsapp-automation",
		"whatsapp-business",
		"turbo-notify",
		"turbonotify",
		"messaging",
		"notifications",
		"mcp"
	],
	"author": {
		"name": "Turbo Notify",
		"email": "support@turbonotify.com",
		"url": "https://turbonotify.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/turbo-notify/n8n-nodes-turbo-notify.git"
	},
	"bugs": {
		"url": "https://github.com/turbo-notify/n8n-nodes-turbo-notify/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"format": "prettier nodes credentials test --write"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TurboNotifyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TurboNotify/TurboNotify.node.js",
			"dist/nodes/TurboNotifyTrigger/TurboNotifyTrigger.node.js",
			"dist/nodes/TurboNotifyPollingTrigger/TurboNotifyPollingTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.4",
		"@types/jest": "^29.5.14",
		"eslint": "9.32.0",
		"jest": "^29.7.0",
		"n8n-workflow": "*",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"ts-jest": "^29.2.5",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
