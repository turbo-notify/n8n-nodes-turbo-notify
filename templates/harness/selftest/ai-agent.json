{
	"name": "Harness selftest: AI agent with a tool and a send",
	"nodes": [
		{
			"parameters": {},
			"id": "5e1f0a10-0000-4000-8000-000000000021",
			"name": "When clicking Test workflow",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [0, 0]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{ "id": "a1", "name": "chatInput", "value": "What is 6 times 7?", "type": "string" },
						{ "id": "a2", "name": "phone", "value": "+5511977770005", "type": "string" }
					]
				},
				"options": {}
			},
			"id": "5e1f0a10-0000-4000-8000-000000000022",
			"name": "Customer question",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [240, 0]
		},
		{
			"parameters": {
				"promptType": "define",
				"text": "={{ $json.chatInput }}",
				"options": {
					"systemMessage": "You are a terse assistant at the harness desk."
				}
			},
			"id": "5e1f0a10-0000-4000-8000-000000000023",
			"name": "AI Agent",
			"type": "@n8n/n8n-nodes-langchain.agent",
			"typeVersion": 2.2,
			"position": [480, 0]
		},
		{
			"parameters": {
				"model": { "__rl": true, "mode": "list", "value": "fake-model" },
				"options": {}
			},
			"id": "5e1f0a10-0000-4000-8000-000000000024",
			"name": "OpenAI Chat Model",
			"type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
			"typeVersion": 1.2,
			"position": [420, 220],
			"credentials": {
				"openAiApi": {
					"id": "REPLACE_WITH_YOUR_CREDENTIAL",
					"name": "OpenAI account"
				}
			}
		},
		{
			"parameters": {},
			"id": "5e1f0a10-0000-4000-8000-000000000025",
			"name": "Calculator",
			"type": "@n8n/n8n-nodes-langchain.toolCalculator",
			"typeVersion": 1,
			"position": [580, 220]
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "sendText",
				"number": { "__rl": true, "mode": "list", "value": "main", "cachedResultName": "main" },
