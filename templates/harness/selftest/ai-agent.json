			"id": "5e1f0a10-0000-4000-8000-000000000026",
			"name": "Send the answer",
			"type": "@turbo-notify/n8n-nodes-turbo-notify.turboNotify",
			"typeVersion": 1,
			"position": [800, 0],
			"credentials": {
				"turboNotifyApi": {
					"id": "REPLACE_WITH_YOUR_CREDENTIAL",
					"name": "Turbo Notify API"
				}
			}
		}
	],
	"connections": {
		"When clicking Test workflow": { "main": [[{ "node": "Customer question", "type": "main", "index": 0 }]] },
		"Customer question": { "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]] },
		"OpenAI Chat Model": { "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]] },
		"Calculator": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] },
		"AI Agent": { "main": [[{ "node": "Send the answer", "type": "main", "index": 0 }]] }
