{
	"name": "Harness selftest: send one text and read its status",
	"nodes": [
		{
			"parameters": {},
			"id": "5e1f0a10-0000-4000-8000-000000000001",
			"name": "When clicking Test workflow",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [0, 0]
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "sendText",
				"number": {
					"__rl": true,
					"mode": "list",
					"value": "main",
					"cachedResultName": "main"
				},
				"recipientType": "phone",
				"phoneNumber": "+5511977770001",
				"text": "Harness selftest: your order is on its way.",
				"options": {
					"idempotencyKey": "selftest-order-1"
				}
			},
			"id": "5e1f0a10-0000-4000-8000-000000000002",
			"name": "Send the text",
			"type": "@turbo-notify/n8n-nodes-turbo-notify.turboNotify",
			"typeVersion": 1,
			"position": [260, 0],
			"credentials": {
				"turboNotifyApi": {
					"id": "REPLACE_WITH_YOUR_CREDENTIAL",
					"name": "Turbo Notify API"
				}
			}
		},
		{
			"parameters": {
				"amount": 3,
				"unit": "seconds"
			},
			"id": "5e1f0a10-0000-4000-8000-000000000003",
			"name": "Wait 3 seconds",
			"type": "n8n-nodes-base.wait",
			"typeVersion": 1.1,
			"position": [520, 0]
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "getStatus",
				"number": {
					"__rl": true,
					"mode": "id",
					"value": "={{ $('Send the text').item.json.number_alias }}"
				},
				"messageId": "={{ $('Send the text').item.json.id }}"
			},
			"id": "5e1f0a10-0000-4000-8000-000000000004",
			"name": "Get the status",
			"type": "@turbo-notify/n8n-nodes-turbo-notify.turboNotify",
			"typeVersion": 1,
			"position": [780, 0],
			"credentials": {
				"turboNotifyApi": {
					"id": "REPLACE_WITH_YOUR_CREDENTIAL",
					"name": "Turbo Notify API"
				}
			}
		}
	],
	"connections": {
		"When clicking Test workflow": { "main": [[{ "node": "Send the text", "type": "main", "index": 0 }]] },
		"Send the text": { "main": [[{ "node": "Wait 3 seconds", "type": "main", "index": 0 }]] },
		"Wait 3 seconds": { "main": [[{ "node": "Get the status", "type": "main", "index": 0 }]] }
	},
	"pinData": {},
	"settings": {
		"executionOrder": "v1"
	}
